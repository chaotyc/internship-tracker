{
  "name": "internship-tracker",
  "version": "0.1.0",
  "description": "Local-first desktop tracker for internship and job applications, with AI search, a chat assistant and form autofill.",
  "author": "chaotyc",
  "homepage": "https://github.com/chaotyc/internship-tracker#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/chaotyc/internship-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/chaotyc/internship-tracker/issues"
  },
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "icon": "node scripts/icon.mjs",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "imapflow": "2.11.0",
    "mammoth": "1.13.0",
    "postal-mime": "4.2.0",
    "sql.js": "1.15.2",
    "unpdf": "2.1.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "jszip": "3.10.2",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": false
  },
  "build": {
    "appId": "dev.internshiptracker.app",
    "productName": "Internship Tracker",
    "artifactName": "Internship-Tracker-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json",
      "!**/node_modules/**/{docs,doc,benchmarks,benchmark,test,tests,__tests__,example,examples}/**",
      "!**/node_modules/**/*.{md,markdown,map,ts,tsx,flow}",
      "!**/node_modules/**/{CHANGELOG,HISTORY,README}*"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Internship Tracker"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "chaotyc <chaotyc@users.noreply.github.com>",
      "synopsis": "Track internship and job applications on your own computer",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "chaotyc",
        "repo": "internship-tracker",
        "releaseType": "draft"
      }
    ]
  }
}
