{
  "name": "internship-tracker",
  "version": "0.1.0",
  "description": "Local-first desktop tracker for internship and job applications, with AI search, a chat assistant and form autofill.",
  "main": "out/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --mac --dir"
  },
  "dependencies": {
    "mammoth": "1.13.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "sql.js": "1.15.2",
    "unpdf": "2.1.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "jszip": "3.10.2",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": false
  },
  "build": {
    "appId": "dev.internshiptracker.app",
    "productName": "Internship Tracker",
    "files": [
      "out/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    }
  }
}
